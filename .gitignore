# 运行期数据（数据库、向量、日志）
/data/
*.db
*.db-wal
*.db-shm

# NoneBot 运行产物
/nonebot/
.nonebot/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 虚拟环境
/venv/
.venv/

# 配置与密钥（部署时在服务器上放置，不进仓库）
.env
bot/.env

# NapCat 容器挂载卷（登录态、配置，体积大且含隐私）
napcat/data/
napcat/QQ/

# NapCat 编排的多实例变量（项目名/容器名/端口）。每套实例各一份，不进仓库。
napcat/.env

# 部署产物
deploy/out/
