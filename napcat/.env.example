# ============================================================================
# NapCat 容器编排的多实例变量
#
# docker compose 会自动读取**与本文件同目录**的 `.env`：
#     cp napcat/.env.example napcat/.env
#
# 一项都不填 = 主实例当前的值（项目 napcat / 容器 qqbot-napcat / 6099 / 3001），
# 也就是和没做多实例改造之前完全一样。
#
# `napcat/.env` 已 gitignore —— 它只描述「本机这一套编排」，不要提交仓库。
# ============================================================================

# compose 项目名。⚠️ 两套实例必须不同，否则会被当成同一个项目互相 Recreate。
COMPOSE_PROJECT=napcat

# 容器名
NAPCAT_CONTAINER=qqbot-napcat

# 宿主回环上的 WebUI 端口（管理面板读二维码/WebUI token 就靠它）
NAPCAT_WEBUI_PORT=6099

# 宿主回环上的 OneBot v11 正向 WS 端口
# （必须和 bot/.env 里 ONEBOT_V11_WS_URLS 指向的端口一致）
NAPCAT_WS_PORT=3001

# ---------------------------------------------------------------------------
# 第二套实例参考写法（同机多实例：换名、换端口，避免撞车）：
#
#   COMPOSE_PROJECT=qqbot-second
#   NAPCAT_CONTAINER=napcat-second
#   NAPCAT_WEBUI_PORT=6100
#   NAPCAT_WS_PORT=3002
#
# 对应的 bot/.env 需要同时改：
#   PORT=8082                                        # 面板端口，别和主实例撞
#   ONEBOT_V11_WS_URLS=["ws://127.0.0.1:3002"]
#   QQ_CONTAINER=napcat-second                       # 若面板要用容器操作
# ---------------------------------------------------------------------------
