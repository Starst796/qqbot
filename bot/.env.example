# ============================================================================
# NoneBot2 环境变量模板
# 部署时复制为 bot/.env 并填写真实值（bot/.env 已被 gitignore，不会入库）。
#   cp bot/.env.example bot/.env
# ============================================================================

# ---- NoneBot 驱动：FastAPI（同时承载管理面板的 HTTP 路由）----
# ⚠️ `+~websockets` 不能删：只有 `~fastapi` 时驱动不支持 WebSocket **客户端**连接，
# OneBot 永远连不上，而日志里只留一句很容易被忽略的
# `does not support websocket client connections! Ignored`。
DRIVER=~fastapi+~websockets
HOST=127.0.0.1
PORT=8081
COMMAND_START=["/", ""]

# ---- OneBot v11 适配器：主动连接 NapCat 的「正向 WebSocket 服务器」----
# 列表类型用 JSON 数组；端口需与 NapCat 中配置的一致。
ONEBOT_V11_WS_URLS=["ws://127.0.0.1:3001"]
# 需与 NapCat OneBot 配置里的 access token 完全一致
ONEBOT_V11_ACCESS_TOKEN=

# ---- 超级用户（接收报错通知，可留空）----
SUPERUSERS=[]

# ---- DeepSeek（OpenAI 兼容）----
DEEPSEEK_API_KEY=
# 模型名：DeepSeek-V4.1-Flash 对应的调用名为 deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 联网搜索（工具 web_search，可选）----
# 两项都填才会联网；留空时模型会如实说"搜不了"，不会编造搜索结果。
# 密钥必须放这里而不是 data/config.json：面板的 /api/config 会把配置原样吐出来。
# 推荐 Tavily（https://app.tavily.com，有免费额度），密钥形如 tvly-…
WEB_SEARCH_API_URL=https://api.tavily.com/search
TAVILY_API_KEY=

# ---- 识图工具（image_search，可选；至少配一个）----
# 面板“识图”卡片会写回这两项，保存即热生效。也可以直接填这里后重启。
# SerpAPI：https://serpapi.com/ ，Google Lens 结果，适合找 X/Twitter 账号。
SERPAPI_KEY=
# SauceNAO：https://saucenao.com/user.php?page=search-api ，偏动漫/cosplay，可兜底。
SAUCENAO_API_KEY=
