# ============================================================================
# NoneBot2 环境变量模板
# 部署时复制为 bot/.env 并填写真实值（bot/.env 已被 gitignore，不会入库）。
#   cp bot/.env.example bot/.env
# ============================================================================

# ---- NoneBot 驱动：FastAPI（同时承载管理面板的 HTTP 路由）----
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8081
COMMAND_START=["/", ""]

# ---- OneBot v11 适配器：主动连接 NapCat 的「正向 WebSocket 服务器」----
# 列表类型用 JSON 数组；端口需与 NapCat 中配置的一致。
ONEBOT_V11_WS_URLS=["ws://127.0.0.1:3001"]
# 需与 NapCat OneBot 配置里的 access token 完全一致
ONEBOT_V11_ACCESS_TOKEN=

# ---- 超级用户（接收报错通知，可留空）----
SUPERUSERS=[]

# ---- DeepSeek（OpenAI 兼容）----
DEEPSEEK_API_KEY=
# 模型名：DeepSeek-V4.1-Flash 对应的调用名为 deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
